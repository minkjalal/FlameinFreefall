# Flame in Freefall - Environment Configuration Example
# Copy this file to .env and insert your API keys

# OpenRouter API Key (Recommended for google/gemini-2.5-flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Direct API / SDK fallback)
GEMINI_API_KEY=your_gemini_api_key_here
